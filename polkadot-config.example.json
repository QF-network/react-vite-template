{
  "version": "1.0",
  "project": {
    "name": "my-polkadot-app",
    "chain": "qfn",
    "description": "My custom Polkadot dApp"
  },
  "features": {
    "assets": {
      "enabled": true,
      "operations": ["create", "mint", "transfer", "destroy"]
    },
    "balances": {
      "enabled": false,
      "operations": []
    }
  },
  "ui": {
    "branding": {
      "appName": "My Polkadot App",
      "logoUrl": null
    },
    "theme": "system",
    "layout": "sidebar"
  },
  "advanced": {
    "errorHandling": "basic",
    "queryStaleTime": 30000,
    "toastDuration": 30000,
    "includeDevtools": true
  }
}
